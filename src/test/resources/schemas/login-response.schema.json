{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["success", "token", "user"],
  "properties": {
    "success": {"type": "boolean"},
    "token": {"type": "string", "minLength": 10},
    "user": {
      "type": "object",
      "required": ["email"],
      "properties": {
        "email": {"type": "string"}
      }
    }
  }
}
